---
import "../styles/projects.css";
import "../styles/song-cards.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectsCard.astro";
import projects from "../data/projects.json";

const groupedProjects = Object.groupBy(
	projects,
	(project) => project.category?.trim() || "Other",
);
---

<BaseLayout pageTitle="Projects!" pageID="projects">
	{
		Object.entries(groupedProjects).map(([category, items]) => (
			<section>
				<h2 class="projects-title">{category}</h2>
				<div class="columns-projects">
					{(items ?? []).map((project) => (
						<ProjectCard
							id={project.id}
							title={project.title}
							artist={project.artist}
							cover={project.cover}
							rating={project.rating}
						/>
					))}
				</div>
			</section>
		))
	}
</BaseLayout>
